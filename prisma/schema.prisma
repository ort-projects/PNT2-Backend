generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Producto {
  id          Int    @id @default(autoincrement())
  title       String
  description String
  category    String
  price       Float
  thumbnail   String
  destacado   Boolean @default(false)
  orderItems  PedidoItem[]
  cartItems   CarritoItem[]

  @@map("productos")
}

enum Rol {
  admin
  user
}

model Usuario {
  id       Int    @id @default(autoincrement())
  username String @unique
  name     String
  surname  String
  password String
  role     Rol
  orders   Pedido[]
  cart     Carrito?
}

enum EstadoPedido {
  pendiente
  enviado
  entregado
  cancelado
}

model Pedido {
  id        Int          @id @default(autoincrement())
  date      DateTime     @default(now())
  status    EstadoPedido @default(pendiente)
  userId    Int
  user      Usuario     @relation(fields: [userId], references: [id])
  items     PedidoItem[]
}

model PedidoItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  productId Int
  price     Float
  quantity  Int
  order     Pedido   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Producto @relation(fields: [productId], references: [id])
}

model Carrito {
  id        Int           @id @default(autoincrement())
  userId    Int           @unique
  version   Int           @default(1)
  updatedAt DateTime      @updatedAt
  user      Usuario       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CarritoItem[]
  imports   CarritoImport[]
}

model CarritoItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  productId Int
  quantity  Int
  cart      Carrito  @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Producto @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
}

model CarritoImport {
  id       Int     @id @default(autoincrement())
  cartId   Int
  importId String
  cart     Carrito @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, importId])
}
