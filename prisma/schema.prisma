generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Producto {
  id          Int    @id @default(autoincrement())
  title       String
  description String
  category    String
  price       Float
  thumbnail   String

  @@map("productos")
}

enum Rol {
  admin
  user
}

model Usuario {
  id       Int    @id @default(autoincrement())
  username String @unique
  name     String
  surname  String
  password String
  role     Rol
}
