generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Producto {
  id          Int    @id @default(autoincrement())
  title       String
  description String
  category    String
  price       Float
  thumbnail   String
  orderItems  PedidoItem[]

  @@map("productos")
}

enum Rol {
  admin
  user
}

model Usuario {
  id       Int    @id @default(autoincrement())
  username String @unique
  name     String
  surname  String
  password String
  role     Rol
  orders   Pedido[]
}

model Pedido {
  id        Int         @id @default(autoincrement())
  date      DateTime    @default(now())
  userId    Int
  user      Usuario     @relation(fields: [userId], references: [id])
  items     PedidoItem[]
}

model PedidoItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  productId Int
  price     Float
  quantity  Int
  order     Pedido   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Producto @relation(fields: [productId], references: [id])
}
